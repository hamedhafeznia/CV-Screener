# Google AI Studio key — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Text model used for structured generation, extraction and chat.
# Any free-tier Gemini flash model works.
LLM_MODEL=gemini-3.5-flash

# Embeddings. 768 dims via Matryoshka truncation (see PRD §6.3).
EMBED_MODEL=gemini-embedding-001

# Headshots. NOT on the free tier (~$1 for 30 images).
# If unset or the call fails, generation falls back to local SVG avatars.
IMAGE_MODEL=gemini-3.1-flash-image
