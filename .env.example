# Google AI Studio key — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Text model(s) for generation, extraction and chat.
# The free tier allows 20 requests per DAY per model, so this accepts a
# comma-separated chain: when one model's daily quota is spent the wrapper
# rolls over to the next. With billing enabled, one id is enough.
LLM_MODEL=gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-flash-latest,gemini-3-flash-preview

# Embeddings. 768 dims via Matryoshka truncation (see PRD §6.3).
EMBED_MODEL=gemini-embedding-001

# Headshots. NOT on the free tier (~$1 for 30 images).
# If unset or the call fails, generation falls back to local SVG avatars.
IMAGE_MODEL=gemini-3.1-flash-image

# Streaming pace, in ms between words. Lower is faster; 0 streams as fast as the
# model delivers (which for Gemini means a few large blocks).
STREAM_DELAY_MS=4
